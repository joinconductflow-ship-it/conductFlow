NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
# Alternative to AI_GATEWAY_API_KEY: what `vercel env pull` writes, expires every 12h.
# Read by evals/extraction.eval.ts; npm test needs neither.
VERCEL_OIDC_TOKEN=
# Paces `npm run eval` between model calls (ms) to stay under free-tier rate limits.
# Default 45000 if unset; set to 0 on paid gateway credit.
EVAL_PACE_MS=

# Phase 3 — Google. Sign-in needs the OAuth client; the rest is only needed once an org
# connects Drive, Calendar, or Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloud Console > Credentials > API key; restrict to site origins and Picker API, public unlike the OAuth secret.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Cloud project number (not project ID), from the same project as the OAuth client and Picker key.
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# Wraps the per-row data keys that seal stored refresh tokens. Base64, 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_SOURCE_KEK=
# Set only during a key rotation, holding the outgoing key until the rewrap finishes.
DATA_SOURCE_KEK_PREVIOUS=

# Authorizes the scheduled overdue sweep at /api/cron/reminders.
CRON_SECRET=

# The origin this deployment is served from, scheme included, no trailing slash:
#   https://app.example.com
# Set this in every deployed environment. When it is set, redirect targets and OAuth
# callbacks are built from it and the Host / X-Forwarded-Host headers are never trusted;
# both are attacker-controlled, and the error paths redirect to whatever they say. Leave
# it unset locally and on preview URLs, where the forwarded host is the only way to know.
SITE_ORIGIN=

# Shared secret the extension sends as `x-assistant-secret`; generate via
# `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.
# Not a third-party API key — this only authenticates the extension to this endpoint.
MEETING_ASSISTANT_SECRET=
